#include <stdio.h>
#include <string.h>

void main() {
    char data[30], divisor[10], temp[30];
    int dataLen, divLen, i, j;

    printf("Enter data to be transmitted: ");
    scanf("%s", data);

    printf("Enter the Generating polynomial: ");
    scanf("%s", divisor);

    dataLen = strlen(data);
    divLen = strlen(divisor);

    // Copy data to temp and append zeros
    strcpy(temp, data);
    for (i = dataLen; i < dataLen + divLen - 1; i++)
        temp[i] = '0';
    temp[i] = '\0';

    printf("\nData padded with n-1 zeros : %s\n", temp);

    // CRC calculation
    for (i = 0; i < dataLen; i++) {
        if (temp[i] == '1') {
            for (j = 0; j < divLen; j++) {
                temp[i + j] =
                    (temp[i + j] == divisor[j]) ? '0' : '1';
            }
        }
    }

    printf("CRC or Check value is : ");
    for (i = dataLen; i < dataLen + divLen - 1; i++)
        printf("%c", temp[i]);

    // Append CRC to original data
    for (i = dataLen; i < dataLen + divLen - 1; i++)
        data[i] = temp[i];
    data[i] = '\0';

    printf("\nFinal data to be sent : %s\n", data);

    // Receiver side check
    printf("\nEnter the received data: ");
    scanf("%s", temp);

    for (i = 0; i < strlen(temp) - (divLen - 1); i++) {
        if (temp[i] == '1') {
            for (j = 0; j < divLen; j++) {
                temp[i + j] =
                    (temp[i + j] == divisor[j]) ? '0' : '1';
            }
        }
    }

    // Check for error
    for (i = 0; i < divLen - 1; i++) {
        if (temp[strlen(temp) - i - 1] == '1') {
            printf("Error detected\n");
            return;
        }
    }

    printf("No error detected\n");
}
