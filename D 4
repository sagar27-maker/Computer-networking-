#include <stdio.h>

int main()
{
    int n, src, i, j, u, min;
    int c[20][20], d[20], p[20], v[20];

    printf("Enter the no of routers ");
    scanf("%d", &n);

    printf("Enter the cost matrix values:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
        {
            printf("%d->%d:", i, j);
            scanf("%d", &c[i][j]);
            if (c[i][j] < 0) c[i][j] = 1000;
        }

    printf("Enter the source router: ");
    scanf("%d", &src);

    for (i = 0; i < n; i++)
        d[i] = c[src][i], p[i] = src, v[i] = 0;

    v[src] = 1;

    for (i = 0; i < n; i++)
    {
        min = 1000;
        for (j = 0; j < n; j++)
            if (!v[j] && d[j] < min) min = d[j], u = j;

        v[u] = 1;
        for (j = 0; j < n; j++)
            if (!v[j] && min + c[u][j] < d[j])
                d[j] = min + c[u][j], p[j] = u;
    }

    for (i = 0; i < n; i++)
    {
        printf("\n%d==>%d:Path taken:%d", src, i, i);
        j = i;
        while (j != src)
            printf("\n<--%d", p[j]), j = p[j];
        printf("\nShortest path cost:%d", d[i]);
    }
    return 0;
}
