#include <stdio.h>
#include <math.h>

int data[32], code[32], n, r;

/* Function to calculate parity */
int parity(int pos, int len)
{
    int i, count = 0;
    for (i = pos - 1; i < len; i += 2 * pos)
        for (int j = i; j < i + pos && j < len; j++)
            if (code[j] == 1)
                count++;
    return count % 2;
}

int main()
{
    int i, j = 0, k = 1, total, error = 0;

    printf("Please enter the length of the Data Word: ");
    scanf("%d", &n);

    printf("Please enter the Data Word:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &data[i]);

    /* Calculate number of parity bits */
    for (r = 0; pow(2, r) < (n + r + 1); r++);

    total = n + r;

    /* Insert data bits and parity placeholders */
    for (i = 1; i <= total; i++)
    {
        if (i == pow(2, k - 1))
        {
            code[i - 1] = 0;
            k++;
        }
        else
            code[i - 1] = data[j++];
    }

    /* Calculate parity bits */
    for (i = 0; i < r; i++)
        code[(int)pow(2, i) - 1] = parity(pow(2, i), total);

    printf("The calculated Code Word is: ");
    for (i = 0; i < total; i++)
        printf("%d", code[i]);
    printf("\n");

    printf("Please enter the received Code Word:\n");
    for (i = 0; i < total; i++)
        scanf("%d", &code[i]);

    /* Error detection */
    for (i = 0; i < r; i++)
        if (parity(pow(2, i), total))
            error += pow(2, i);

    if (error == 0)
        printf("The received Code Word is correct.\n");
    else
        printf("Error at bit position: %d\n", error);

    return 0;
}
