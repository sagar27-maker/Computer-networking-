#include <stdio.h>

int main()
{
    int n, i, j, k;
    int d[10][10];

    printf("Enter the number of nodes:");
    scanf("%d", &n);

    /* Read cost matrix */
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            printf("Enter the distance between the host %d - %d:", i+1, j+1);
            scanf("%d", &d[i][j]);
        }
    }

    /* Print input matrix */
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
            printf("%d ", d[i][j]);
        printf("\n");
    }

    /* Floyd–Warshall (BGP logic) */
    for (k = 0; k < n; k++)
        for (i = 0; i < n; i++)
            for (j = 0; j < n; j++)
                if (d[i][j] > d[i][k] + d[k][j])
                    d[i][j] = d[i][k] + d[k][j];

    /* Set diagonal to zero */
    for (i = 0; i < n; i++)
        d[i][i] = 0;

    printf("The output matrix:\n");
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
            printf("%d ", d[i][j]);
        printf("\n");
    }

    return 0;
}
